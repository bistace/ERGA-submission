// Fields marked (mandatory) abort create_bytesea_json when they cannot be resolved.
// Every other field is dropped from the output, with a warning, when its source
// value is missing or unusable.
{
    "main": true, // always true for now
    "submission_date": "2026-07-16T13:11:14.977Z", // today's date when submitting (mandatory)
    "assembly_level": "chromosome", // always chromosomes for now (mandatory)
    // Known by parsing NGL
    "bioproject_umbrella": "string",
    "bioproject_assembly": "string", // (mandatory)
    "bioproject_reads": "string", // (mandatory)
    "assembly_name": "string", // "assemblyToDownloadVersion" in NGL (mandatory)
    "ear_report": "string", // "EARs/<tolid>_EAR.pdf", tolid from NGL (mandatory)
    "atlaseaid_prefix": "", // Leave empty for now
    "main_specimen_code": "string", // "Code unique individu" in NGL (mandatory)
    "assembly_accession": "", // leave empty for now
    "busco_euk_genome_s": 0,
    "busco_euk_genome_d": 0,
    "busco_euk_genome_m": 0,
    "busco_euk_genome_f": 0,
    "busco_euk_dataset": 0,
    "busco_euk_nbgenes": 0,
    "busco_lin_genome_s": 0,
    "busco_lin_genome_d": 0,
    "busco_lin_genome_m": 0,
    "busco_lin_genome_f": 0,
    "busco_lin_dataset": 0,
    "busco_lin_nbgenes": 0,
    "merqury_completion": 0.0,
    "merqury_score": 0.0,
    // Known by parsing the NGL-BI readsets and their NGL-SQ samples
    "sequencing": [ // one entry per sequencing type and specimen
        {
            "sequencing_type": "short_read", // short_read, long_read or hi_c
            "creation_date": "2026-05-12T00:00:00", // readset run start date
            "main": false, // true when built from a master readset
            "specimens": ["A-76EV3UNTE"] // "Code unique individu" of the readset sample
        }
    ],
    // Known by parsing the submission manifest, which is optional
    "ena_sample_code": "string", // SAMPLE field
    // Known by parsing busco logs
    "busco_version": "0.0.0",
    "busco_dataset_version": "odb12",
    // Known by parsing gfastats logs
    "nb_scaffolds": 0,
    "size": 0, // (mandatory)
    "gc_content": 0, // (mandatory)
    "n50_scaffolds": 0,
    "n90_scaffolds": 0,
    "l50_scaffolds": 0,
    "l90_scaffolds": 0,
    "nb_contigs": 0,
    "n50_contigs": 0,
    "n90_contigs": 0,
    "l50_contigs": 0,
    "l90_contigs": 0,
}